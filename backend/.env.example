# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ==========================================
DB_USER=informa_saude_app
DB_PASSWORD=substitua_pela_senha_local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=informa_saude_dev

# ==========================================
# AUTENTICAÇÃO JWT
# ==========================================

# Utilize uma chave aleatória e segura.
# A configuração exige pelo menos 32 caracteres.
SECRET_KEY=substitua_por_uma_chave_aleatoria_com_32_ou_mais_caracteres

# ==========================================
# ENVIO DE E-MAIL
# ==========================================
EMAIL_REMETENTE=seu-email-verificado@exemplo.com
BREVO_API_KEY=substitua_pela_chave_da_brevo

# ==========================================
# AUTENTICAÇÃO GOOGLE
# ==========================================
GOOGLE_CLIENT_ID=substitua_pelo_client_id_google